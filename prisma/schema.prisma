// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id          String   @id @default(cuid())
  rootWord    String   // Akar kata (contoh: كتب, اكرم)
  indonesian  String   // Arti bahasa Indonesia (opsional di awal)
  bab         String?  // Bab fi'il (contoh: Bab 1, Asalnya Af'ala)
  bina        String?  // Jenis bina' terperinci (contoh: Shohih Salim, Shohih Mahmuz Fa', dll)
  transitive  String?  // Lazim / Muta'addi / Keduanya
  jenisFiil   String?  // Tsulatsi Mujarrod / Tsulatsi Mazid / Ruba'i Mujarrod / Ruba'i Mazid
  
  // Tasrif Istilahi (Lafadz Arab)
  madhi       String
  mudhari     String
  masdar      String[] // Mendukung lebih dari 1 masdar
  masdarMim   String?
  faail       String
  mafuul      String?
  amr         String
  nahyi       String
  zamanMakan  String
  alaat       String?
  
  // Wazan Overrides (Opsional)
  wazanMasdar     String[]
  wazanZamanMakan String?
  wazanAlaat      String?

  // Arti Kontekstual per Shighot (Opsional / Override)
  artiMadhi       String?
  artiMudhari     String?
  artiMasdar      String[]
  artiMasdarMim   String?
  artiFaail       String?
  artiMafuul      String?
  artiAmr         String?
  artiNahyi       String?
  artiZamanMakan  String?
  artiAlaat       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([madhi, bab])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow Data Sima'i: Qutrub → AI Enrichment → Verifikasi → Publish
// ─────────────────────────────────────────────────────────────────────────────
//
// Alur:
//   1. IMPORT    : Ekstrak dari Qutrub → status DRAFT (data mentah)
//   2. ENRICH    : AI isi arti Indo, akar kata, wazan sima'i (batch) → AI_DONE
//   3. VERIFIKASI: Manusia cek via /admin/verifikasi → VERIFIED / REJECTED
//   4. PUBLISH   : VERIFIED → disalin ke Word → PUBLISHED
//
// Prinsip: Word hanya berisi data terverifikasi.
//          SimaIImport adalah staging area — boleh kotor, boleh diulang.
//
model SimaIImport {
  id          String   @id @default(cuid())
  batchId     String   // ID batch, misal "2026-10-19-001"

  // ── Data mentah dari Qutrub ──
  qutrubRaw   Json     // Output mentah Qutrub (jangan diubah)

  // ── Hasil AI enrichment (bisa diedit saat verifikasi) ──
  rootWord    String?
  indonesian  String?
  bab         String?
  bina        String?
  transitive  String?
  jenisFiil   String?
  madhi       String?
  mudhari     String?
  masdar      String[]
  masdarMim   String?
  faail       String?
  mafuul      String?
  amr         String?
  nahyi       String?
  zamanMakan  String?
  alaat       String?

  // ── Metadata AI ──
  aiModel     String?  // Model AI yang dipakai
  aiConfidence Float?  // Skor kepercayaan AI (0-1)
  aiNotes     String?  // Catatan AI (misal: "masdar tidak yakin")

  // ── Workflow ──
  status      String   @default("DRAFT")
  // DRAFT → AI_DONE → VERIFIED → PUBLISHED
  //                ↘ REJECTED

  verifiedBy  String?
  verifiedAt  DateTime?
  verifierNotes String?
  publishedAt DateTime?
  publishedWordId String? // ID di tabel Word setelah publish

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([batchId, status])
}
